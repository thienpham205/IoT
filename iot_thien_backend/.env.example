PORT=3000

# MySQL (khớp với docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iot_thien
DB_PASSWORD=iot_thien_password
DB_NAME=iot_thien

# JWT - đặt chuỗi bí mật riêng của bạn
JWT_SECRET=change_me
JWT_EXPIRES_IN=3600

# MQTT broker
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

TOPIC_SENSOR_DATA=iot/sensors/+/data
TOPIC_DEVICE_STATUS=iot/devices/+/status
TOPIC_DEVICE_COMMAND_PREFIX=iot/devices
TOPIC_HEARTBEAT=iot/nodes/+/heartbeat

# Thời gian chờ ACK từ ESP8266 (ms)
CONTROL_ACK_TIMEOUT_MS=5000
